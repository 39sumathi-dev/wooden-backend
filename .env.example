# ================================================================
# SK WOOD TURNERY — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual credentials.
# ================================================================

# --- MONGODB ATLAS CONFIGURATION ---
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.tp0iccb.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=sk_woodturnery

# --- CLOUDFLARE R2 STORAGE CONFIGURATION (S3-Compatible) ---
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=woodturnery-products
R2_PUBLIC_URL=https://your_account_id.r2.cloudflarestorage.com

# --- PAYMENT GATEWAY CONFIGURATION ---
PAYMENT_GATEWAY_MODE=sandbox
PAYMENT_CURRENCY=INR
RAZORPAY_KEY_ID=rzp_test_your_key
RAZORPAY_KEY_SECRET=rzp_test_your_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key

# --- ADMIN PANEL CREDENTIALS ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password
